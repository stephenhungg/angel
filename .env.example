# Shared secrets (never commit a real .env). Copy to .env.local in each workspace.

# === auth + crypto (MUST MATCH between web and desktop) ===
JWT_SECRET=replace-me-with-strong-random-32-byte-value

# === convex ===
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=                  # only for ci/deploy

# === llm + memory ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...               # codex + embeddings
NIA_API_KEY=

# === optional ===
DEEPGRAM_API_KEY=                   # voice input (cuttable)
ELEVENLABS_API_KEY=                 # if voice cloning later
TENSORLAKE_API_KEY=                 # always-on track sponsor — document ingestion + structured extraction (api.tensorlake.ai). when unset, desktop/electron/agent/tensorlake/client.ts uses TensorlakeMockClient with a hand-crafted portfolio observation so the demo never hard-breaks. Get a key at tensorlake.ai (free for the hackathon).
TENSORLAKE_FORCE_MOCK=              # set to 1 to force the mock client even when an API key is configured (useful for offline rehearsals).

# === deploy ===
VERCEL_TOKEN=                       # for agent-driven deploys
GITHUB_TOKEN=                       # for codex git ops
