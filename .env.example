# Shared secrets (never commit a real .env). Copy to .env.local in each workspace.

# === auth + crypto (MUST MATCH between web and desktop) ===
JWT_SECRET=replace-me-with-strong-random-32-byte-value

# === convex ===
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=                  # only for ci/deploy

# === llm + memory ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...               # codex + embeddings
NIA_API_KEY=

# === optional ===
DEEPGRAM_API_KEY=                   # voice input (cuttable)
ELEVENLABS_API_KEY=                 # if voice cloning later
TENSORLAKE_API_KEY=                 # always-on track sponsor — document ingestion + structured extraction (api.tensorlake.ai). when unset, desktop/electron/agent/tensorlake/client.ts uses TensorlakeMockClient with a hand-crafted portfolio observation so the demo never hard-breaks. Get a key at tensorlake.ai (free for the hackathon).
TENSORLAKE_FORCE_MOCK=              # set to 1 to force the mock client even when an API key is configured (useful for offline rehearsals).

# === sms / imessage surface (her thinnest body) ===
# pick ONE provider — factory prefers sendblue > twilio > noop.
#
# twilio: instant signup, SMS only (not iMessage). recommended for the demo
# unless you've pre-registered with sendblue. trial credits come with a free
# us number; verify your test recipient number in the twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                # E.164, e.g. +14155551234

# sendblue: REAL iMessage. requires phone-number registration (24-72h).
# leave blank for now; flip on post-hackathon.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=

# the public number judges text to reach angel. surfaced in docs/SMS_DEMO.md.
ANGEL_PHONE_NUMBER=

# the public convex http url for the inbound webhook. derived from your
# convex deployment, e.g. https://necessary-leopard-395.convex.site/sms/inbound
ANGEL_SMS_WEBHOOK_URL=

# set to "1" to skip provider signature validation (local curl testing only).
ANGEL_SMS_INSECURE=

# === discord surface (her third body — bypasses A2P 10DLC) ===
# from Discord Developer Portal → your app → General Information.
# the public key is used for Ed25519 verification on every interaction.
DISCORD_PUBLIC_KEY=
# from the same place — used in the followup webhook URL at runtime.
DISCORD_APPLICATION_ID=
# from Discord Developer Portal → Bot tab. ONLY used to register slash
# commands once via curl (see convex/discord/orchestrator.ts comments).
# NOT used at runtime — runtime auth is the per-interaction token.
DISCORD_BOT_TOKEN=

# === deploy ===
VERCEL_TOKEN=                       # for agent-driven deploys
GITHUB_TOKEN=                       # for codex git ops
