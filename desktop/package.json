{
  "name": "@angel/desktop",
  "version": "0.0.3",
  "private": true,
  "description": "electron app — embodied 3d room, agent loop, codex executor",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "predev": "bun run scripts/sync-library.ts",
    "prebuild": "bun run scripts/sync-library.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "sync-library": "bun run scripts/sync-library.ts",
    "lint": "eslint src electron --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepackage": "bun run build",
    "package": "electron-builder --mac --arm64",
    "package:dir": "electron-builder --dir --mac --arm64"
  },
  "build": {
    "appId": "com.stephenhungg.angel",
    "productName": "Angel",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      { "from": "public", "to": "public", "filter": ["**/*"] },
      { "from": "electron/data", "to": "electron/data", "filter": ["**/*"] },
      {
        "from": "electron/agent",
        "to": "electron/agent",
        "filter": [
          "personality_synthesis.prompt.md",
          "personality_examples/**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["angel"],
            "CFBundleURLName": "Angel Claim"
          }
        ]
      }
    },
    "dmg": {
      "title": "Angel",
      "icon": "build/icon.icns",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "@angel/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.30.0",
    "@pixiv/three-vrm": "^3.0.0",
    "@pixiv/three-vrm-animation": "^3.0.0",
    "@react-three/drei": "^9.100.0",
    "@react-three/fiber": "^8.16.0",
    "convex": "^1.13.0",
    "framer-motion": "^11.0.0",
    "jsonwebtoken": "^9.0.0",
    "openai": "^4.60.0",
    "playwright": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "10",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "gsap": "^3.15.0",
    "postcss": "8",
    "tailwindcss": "3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
